{
  "name": "fragrances-and-co",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "setup": "node scripts/setup.mjs && prisma generate && prisma migrate deploy && prisma db seed",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:password": "node scripts/admin-password.mjs",
    "telegram:retry": "node server/src/retry-telegram.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "engines": { "node": ">=22.12.0" },
  "overrides": { "deepmerge-ts": "^8.0.0" },
  "devDependencies": { "concurrently": "^9.2.1", "prisma": "6.19.3" }
}
