generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  categoryInfo Category @relation(fields: [category], references: [slug], onDelete: Restrict, onUpdate: Cascade)
  nameRu      String
  nameUz      String
  nameEn      String
  descriptionRu String
  descriptionUz String
  descriptionEn String
  notesRu     String   @default("")
  notesUz     String   @default("")
  notesEn     String   @default("")
  isFeatured  Boolean  @default(false)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      ProductImage[]
  requests    SampleRequest[]
}

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameRu    String
  nameUz    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]
}

model ProductImage {
  id        String  @id @default(cuid())
  path      String
  alt       String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model SampleRequest {
  id             String   @id @default(cuid())
  name           String
  contact        String
  company        String   @default("")
  message        String   @default("")
  locale         String   @default("ru")
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName    String   @default("")
  telegramStatus String   @default("pending")
  telegramAttempts Int    @default(0)
  consentAt      DateTime @default(now())
  createdAt      DateTime @default(now())
}

model AdminSession {
  id        String   @id
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())
}
